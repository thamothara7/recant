# Core local development
DATABASE_URL=postgresql://root@localhost:26257/recant?sslmode=disable
RECANT_API=http://localhost:8000
RECANT_GATEWAY_URL=http://localhost:8000
RECANT_GUARD_URL=http://localhost:8003

# Local compatibility defaults. Production mode overrides all three to true.
RECANT_ENV=development
RECANT_AUTH_MODE=disabled
RECANT_DB_RLS=false
RECANT_REQUIRE_PROVENANCE=false
# RECANT_API_TOKEN=
# RECANT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Gateway and provenance
RECANT_UNTRUSTED_TTL_DAYS=7
# RECANT_CONTROL_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/...

# Taint engine
RECANT_EMBEDDER=hash
# RECANT_TAINT_THRESHOLD=
RECANT_TAINT_TOP_K=20
RECANT_TAINT_MAX_K=320
RECANT_CLAIM_VERIFIER=conservative
# RECANT_CLAIM_MODEL=

# Guard
RECANT_PERMIT_TTL_SECONDS=60
# Production requires a secret 32-byte base64 or 64-character hex key.
# RECANT_IDEMPOTENCY_ENCRYPTION_KEY=

# Fanout
RECANT_FANOUT_POLL_MS=250
# RECANT_EVENT_BUS=recant
# RECANT_EVENT_MANIFEST_BUCKET=
RECANT_EVENT_MANIFEST_MAX_BYTES=16777216

# Forensics and immutable evidence
RECANT_AFFIDAVIT=template
# RECANT_AFFIDAVIT_MODEL=
# RECANT_EVIDENCE_BUCKET=
# RECANT_CHECKPOINT_BUCKET=
RECANT_OBJECT_LOCK_DAYS=0

# Browser origins allowed to read API responses and judge-overlay headers
RECANT_CORS_ORIGINS=http://localhost:5173

# Cloud values belong only in the gitignored .env file or a secret manager.
# DATABASE_URL_CLOUD=postgresql://recant_app:...@...
